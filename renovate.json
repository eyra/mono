{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:earlyMondays",
    "group:allNonMajor"
  ],
  "timezone": "Europe/Amsterdam",
  "constraints": {
    "erlang": "28.1.0.0",
    "elixir": "1.19.6"
  },
  "ignoreDeps": [
    "bamboo_phoenix",
    "bamboo_ses",
    "live_nest",
    "certifi"
  ],
  "packageRules": [
    {
      "matchPackagePatterns": ["*"],
      "automerge": false
    },
    {
      "description": "httpoison 2.3+ blocked by packmatic ~> 2.2.1 dependency",
      "matchPackageNames": ["httpoison"],
      "enabled": false
    },
    {
      "description": "gettext 1.0+ blocked by timex 3.7.13 requiring ~> 0.26",
      "matchPackageNames": ["gettext"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "hackney 3.x blocked by ex_aws ~> 2.4 requiring ~> 1.16",
      "matchPackageNames": ["hackney"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "phoenix_live_view 1.2+ blocked by live_nest requiring ~> 1.1.10, until live_nest supports LiveView 1.2",
      "matchPackageNames": ["phoenix_live_view"],
      "allowedVersions": "<1.2"
    },
    {
      "description": "Toolchain updates get their own PR, outside the weekly group: move CI, images and the constraints above in the same change",
      "matchManagers": ["asdf", "dockerfile", "github-actions", "renovate-config"],
      "matchDepNames": ["erlang", "elixir", "node"],
      "groupName": "toolchain",
      "groupSlug": "toolchain",
      "automerge": false
    },
    {
      "description": "Debian major bumps break AWS prod (Ubuntu 20.04 / glibc 2.31) — keep on debian:12 until prod is upgraded",
      "matchPackageNames": ["debian"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "rangeStrategy": "pin"
}
