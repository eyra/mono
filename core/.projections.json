{
  "**/email/*.html.eex": {
    "type": "html-email",
    "alternate": "{dirname}/email/{basename}.text.eex"
  },
  "**/email/*.text.eex": {
    "type": "text-email",
    "alternate": "{dirname}/email/{basename}.html.eex"
  },
  "mica/test/systems/*_test.exs": {
    "type": "test",
    "alternate": "mica/systems/{}.ex",
    "template": [
      "defmodule Systems.{camelcase|capitalize|dot}Test do",
      "  use Core.DataCase, async: true",
      "  alias Core.Factories",
      "  alias {camelcase|capitalize|dot}",
      "",
      "  describe \"\" do",
      "    test \"\" do",
      "    end",
      "  end",
      "end"
    ]
  },
  "next/test/systems/*_test.exs": {
    "type": "test",
    "alternate": "next/systems/{}.ex",
    "template": [
      "defmodule Systems.{camelcase|capitalize|dot}Test do",
      "  use Core.DataCase, async: true",
      "  alias Core.Factories",
      "  alias {camelcase|capitalize|dot}",
      "",
      "  describe \"\" do",
      "    test \"\" do",
      "    end",
      "  end",
      "end"
    ]
  },
  "mica/test/*_test.exs": {
    "type": "test",
    "alternate": "mica/lib/{}.ex",
    "template": [
      "defmodule {camelcase|capitalize|dot}Test do",
      "  use Core.DataCase, async: true",
      "  alias Core.Factories",
      "  alias {camelcase|capitalize|dot}",
      "",
      "  describe \"\" do",
      "    test \"\" do",
      "    end",
      "  end",
      "end"
    ]
  },
  "mica/systems/*.ex": {
    "type": "code",
    "alternate": "mica/test/systems/{}_test.exs"
  },
  "next/systems/*.ex": {
    "type": "code",
    "alternate": "next/test/systems/{}_test.exs"
  },
  "mica/lib/*.ex": {
    "type": "code",
    "alternate": "mica/test/{}_test.exs"
  },
  "mica/lib/*.html.eex": {
    "type": "template"
  },
  "priv/**/migrations/*.exs": {
    "type": "migration"
  },
  "guides/*.md": {
    "type": "guide"
  },
  "config/*.exs": {
    "type": "config"
  }
}
