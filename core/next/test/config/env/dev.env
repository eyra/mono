# Fly dev (eyra-next-dev): the [env] of fly.dev.toml, the names in
# `fly secrets list` and FLY_APP_NAME, which Fly sets itself. Values are
# dummies, usually the name itself; values that must parse are realistic.
# AWS_S3_BUCKET is a private Tigris bucket for donations; PUBLIC_S3_BUCKET is
# the public one for content and Feldspar apps.
FLY_APP_NAME=eyra-next-dev
HTTP_PORT=8000
PHX_HOST=eyra-next-dev.fly.dev
ECTO_IPV6=true
APP_NAME=Next [dev]
APP_DOMAIN=eyra-next-dev.fly.dev
APP_MAIL_DOMAIN=APP_MAIL_DOMAIN
APP_ADMINS=*@eyra.co
UPLOAD_PATH=/app/data/uploads
STATIC_PATH=/app/data/uploads
FELDSPAR_DATA_DONATION_PATH=/app/data/datadonation
FELDSPAR_DATA_DONATION_RETENTION=336
OPP_BASE_URL=https://api-sandbox.onlinebetaalplatform.nl/v1
ENABLED_OBAN_PLUGINS=pruner, lifeline, advert_expiration, data_donation_cleanup, pay_in_expiration, payment_reconciliation, auth_code_cleanup, auto_approve
STORAGE_SERVICES=builtin
STORAGE_S3_PREFIX=storage
CONTENT_S3_PREFIX=content
FELDSPAR_S3_PREFIX=feldspar
PUBLIC_S3_URL=https://fly.storage.tigris.dev/eyra-next-dev-storage
DATABASE_URL=postgres://DB_USER:DB_PASS@eyra-next-dev-db.flycast:5432/eyra_next_dev?sslmode=disable
GOOGLE_SIGN_IN_CLIENT_ID=GOOGLE_SIGN_IN_CLIENT_ID
GOOGLE_SIGN_IN_CLIENT_SECRET=GOOGLE_SIGN_IN_CLIENT_SECRET
SECRET_KEY_BASE=SECRET_KEY_BASE
MAILGUN_API_KEY=MAILGUN_API_KEY
AWS_ACCESS_KEY_ID=AWS_ACCESS_KEY_ID
AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
AWS_REGION=auto
AWS_SECRET_ACCESS_KEY=AWS_SECRET_ACCESS_KEY
AWS_S3_BUCKET=eyra-next-dev-donations
PUBLIC_S3_BUCKET=eyra-next-dev-storage
FELDSPAR_CLEANUP_SCHEDULE=FELDSPAR_CLEANUP_SCHEDULE
SERVICE_LOGIN_KEY=SERVICE_LOGIN_KEY
ENABLED_APP_FEATURES=debug, leaderboard, panl, e2e
UNSPLASH_ACCESS_KEY=UNSPLASH_ACCESS_KEY
UNSPLASH_APP_NAME=UNSPLASH_APP_NAME
APPSIGNAL_PUSH_API_KEY=APPSIGNAL_PUSH_API_KEY
DEPLOY_ENV=dev
USERCHECK_API_KEY=USERCHECK_API_KEY
RATE_QUOTAS=[]
PAYMENT_PROVIDER=opp
OPP_NOTIFICATION_SECRET=OPP_NOTIFICATION_SECRET
PAYMENT_WEBHOOK_BASE_URL=PAYMENT_WEBHOOK_BASE_URL
OPP_API_KEY=OPP_API_KEY
OPP_PARTNER_FEE_PERCENTAGE=10
OPP_MERCHANT_UID=OPP_MERCHANT_UID
CENTERDATA_CLIENT_ID=CENTERDATA_CLIENT_ID
CENTERDATA_CLIENT_SECRET=CENTERDATA_CLIENT_SECRET
