# AWS production: the names in the live systemd unit (eyra/devops
# ansible/roles/predeploy/templates/bundle.service with the eyraco/prod
# inventory). Values are dummies, usually the name itself; values that must
# parse are realistic. Node 01's view: DIST_HOSTS names node 02.
HTTP_PORT=8080
HTTPS_PORT=HTTPS_PORT
DB_NAME=next
DB_USER=DB_USER
DB_PASS=DB_PASS
DB_HOST=eyra-database-prod.abcdefghijkl.eu-central-1.rds.amazonaws.com
DB_URL=ecto://DB_USER:DB_PASS@eyra-database-prod.abcdefghijkl.eu-central-1.rds.amazonaws.com/next
DATABASE_URL=ecto://DB_USER:DB_PASS@eyra-database-prod.abcdefghijkl.eu-central-1.rds.amazonaws.com/next
DB_CA_PATH=/home/next/etc/DB_CA_PATH.pem
DB_TLS_VERIFY=verify_peer
UPLOAD_PATH=/home/next/uploads
STATIC_PATH=/home/next/uploads
APP_NAME=APP_NAME
APP_DOMAIN=APP_DOMAIN
APP_MAIL_DOMAIN=APP_MAIL_DOMAIN
SECRET_KEY_BASE=SECRET_KEY_BASE
SURFCONEXT_SITE=SURFCONEXT_SITE
SURFCONEXT_CLIENT_ID=SURFCONEXT_CLIENT_ID
SURFCONEXT_CLIENT_SECRET=SURFCONEXT_CLIENT_SECRET
GOOGLE_SIGN_IN_CLIENT_ID=GOOGLE_SIGN_IN_CLIENT_ID
GOOGLE_SIGN_IN_CLIENT_SECRET=GOOGLE_SIGN_IN_CLIENT_SECRET
USERCHECK_API_KEY=USERCHECK_API_KEY
UNSPLASH_APP_NAME=UNSPLASH_APP_NAME
UNSPLASH_ACCESS_KEY=UNSPLASH_ACCESS_KEY
SIGN_IN_WITH_APPLE_CLIENT_ID=SIGN_IN_WITH_APPLE_CLIENT_ID
SIGN_IN_WITH_APPLE_TEAM_ID=SIGN_IN_WITH_APPLE_TEAM_ID
SIGN_IN_WITH_APPLE_PRIVATE_KEY_ID=SIGN_IN_WITH_APPLE_PRIVATE_KEY_ID
SIGN_IN_WITH_APPLE_PRIVATE_KEY_PATH=SIGN_IN_WITH_APPLE_PRIVATE_KEY_PATH
APPSIGNAL_PUSH_API_KEY=APPSIGNAL_PUSH_API_KEY
APPSIGNAL_REVISION=APPSIGNAL_REVISION
RELEASE_ENV=RELEASE_ENV
WEB_PUSH_PUBLIC_KEY=WEB_PUSH_PUBLIC_KEY
WEB_PUSH_PRIVATE_KEY=WEB_PUSH_PRIVATE_KEY
DIST_HOSTS=ec2-web-prod-02
RELEASE_COOKIE=RELEASE_COOKIE
AWS_ACCESS_KEY_ID=AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=AWS_SECRET_ACCESS_KEY
PUBLIC_S3_BUCKET=PUBLIC_S3_BUCKET
PUBLIC_S3_URL=PUBLIC_S3_URL
FELDSPAR_S3_PREFIX=FELDSPAR_S3_PREFIX
CONTENT_S3_PREFIX=CONTENT_S3_PREFIX
STORAGE_S3_PREFIX=STORAGE_S3_PREFIX
STORAGE_UPLOAD_MAX_SIZE=200000000
AWS_REGION=AWS_REGION
AWS_S3_BUCKET=AWS_S3_BUCKET
SSL_DOMAINS=SSL_DOMAINS
ENABLED_APP_FEATURES=debug, leaderboard
PAYMENT_PROVIDER=opp
ENABLED_OBAN_PLUGINS=pruner, lifeline, job_data_cleanup
APP_ADMINS=*@APP_ADMINS
LOG_LEVEL=LOG_LEVEL
RATE_QUOTAS=[{"service":"RATE_QUOTAS","limit":1,"unit":"call","window":"minute","scope":"local"}]
FELDSPAR_DATA_DONATION_PATH=/home/next/datadonation
FELDSPAR_DATA_DONATION_RETENTION=336
