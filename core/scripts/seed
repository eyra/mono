#!/bin/bash
# Run database seeds for the current environment.
# Safe to run multiple times — all seed operations are idempotent.
#
# Usage (from the core/ directory):
#   scripts/seed            # uses MIX_ENV (default: dev)
#   BUNDLE=next MIX_ENV=test scripts/seed   # the test env takes its SaaS from BUNDLE only

set -e

cd "$(dirname "$0")/.."

echo "Running seeds (MIX_ENV=${MIX_ENV:-dev})..."

mix eval "
  Application.put_env(:mica, Mica.SaaS.module().endpoint(), server: false)
  {:ok, _} = Application.ensure_all_started(:mica)
  Mica.Seeds.seed()
"

echo "Done."
