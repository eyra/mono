#!/bin/bash
# Starts the GitHub Release workflow for the current branch and prints its build tag.
# Usage (from the core/ directory): mix github_release
set -euo pipefail

gh workflow run Release --repo eyra/mono --ref "$(git rev-parse --abbrev-ref HEAD)" -f bundle=next
sleep 2
NUM=$(gh run list --repo eyra/mono --workflow Release --limit 1 --json number --jq '.[0].number')
URL=$(gh run list --repo eyra/mono --workflow Release --limit 1 --json url --jq '.[0].url')
echo "Build tag: next_$(date +%F)_$NUM"
echo "URL: $URL"
